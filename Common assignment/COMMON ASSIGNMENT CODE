""TCP and UDP server for the CSA0711 client-server communication system."""
import socket
import threading
import time

HOST = "0.0.0.0"
TCP_PORT = 5000
UDP_PORT = 5001
BUFFER = 1024


def handle_tcp_client(conn, addr):
    print(f"[TCP] Connection established with {addr}")
    try:
        with conn:
            while True:
                data = conn.recv(BUFFER)
                if not data:
                    break
                text = data.decode()
                print(f"[TCP] Received from {addr}: {text}")
                conn.sendall(f"ACK: {text}".encode())
    except ConnectionResetError:
        print(f"[TCP] Connection reset by {addr}")
    print(f"[TCP] Connection closed with {addr}")


def tcp_server():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as srv:
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind((HOST, TCP_PORT))
        srv.listen(5)
        print(f"[TCP] Server listening on port {TCP_PORT}")
        while True:
            conn, addr = srv.accept()
            threading.Thread(target=handle_tcp_client,
                             args=(conn, addr), daemon=True).start()


def udp_server():
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as srv:
        srv.bind((HOST, UDP_PORT))
        print(f"[UDP] Server listening on port {UDP_PORT}")
        while True:
            data, addr = srv.recvfrom(BUFFER)
            text = data.decode()
            print(f"[UDP] Received from {addr}: {text}")
            srv.sendto(f"ACK: {text}".encode(), addr)


if _name_ == "_main_":
    threading.Thread(target=tcp_server, daemon=True).start()
    threading.Thread(target=udp_server, daemon=True).start()
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nServer stopped.")


"""Compare average round-trip time of TCP and UDP over N messages."""
import statistics
import time
import socket
from client import send_tcp, send_udp
import io
import contextlib

N = 200
msgs = [f"message {i}" for i in range(N)]

with contextlib.redirect_stdout(io.StringIO()):
    t0 = time.perf_counter()
    tcp = send_tcp("BENCH", "127.0.0.1", 5000, msgs)
    tcp_total = (time.perf_counter() - t0) * 1000
    t0 = time.perf_counter()
    udp = send_udp("BENCH", "127.0.0.1", 5001, msgs)
    udp_total = (time.perf_counter() - t0) * 1000

print(f"Messages sent per protocol : {N}")
print(f"TCP  delivered {len(tcp)}/{N} | avg {statistics.mean(tcp):.4f} ms | "
      f"min {min(tcp):.4f} | max {max(tcp):.4f} | total {tcp_total:.1f} ms")
print(f"UDP  delivered {len(udp)}/{N} | avg {statistics.mean(udp):.4f} ms | "
      f"min {min(udp):.4f} | max {max(udp):.4f} | total {udp_total:.1f} ms")


"Client for the CSA0711 TCP/UDP communication system."""
import argparse
import socket
import time

TCP_PORT = 5000
UDP_PORT = 5001


def send_tcp(client_id, ip, port, messages):
    results = []
    start = time.perf_counter()
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(3)
        s.connect((ip, port))
        print(f"[{client_id}] Connection status: CONNECTED to {ip}:{port}")
        for msg in messages:
            t0 = time.perf_counter()
            s.sendall(f"{client_id}|{msg}".encode())
            reply = s.recv(1024).decode()
            ms = (time.perf_counter() - t0) * 1000
            print(f"[{client_id}] Sent: {msg} | Received: {reply} | "
                  f"Time: {ms:.3f} ms | ACK: RECEIVED")
            results.append(ms)
    print(f"[{client_id}] Connection status: CLOSED")
    return results


def send_udp(client_id, ip, port, messages):
    results = []
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(2)
        print(f"[{client_id}] Connection status: CONNECTIONLESS (UDP)")
        for msg in messages:
            t0 = time.perf_counter()
            s.sendto(f"{client_id}|{msg}".encode(), (ip, port))
            try:
                reply, _ = s.recvfrom(1024)
                ms = (time.perf_counter() - t0) * 1000
                print(f"[{client_id}] Sent: {msg} | Received: {reply.decode()} | "
                      f"Time: {ms:.3f} ms | ACK: RECEIVED")
                results.append(ms)
            except socket.timeout:
                print(f"[{client_id}] Sent: {msg} | ACK: NOT RECEIVED "
                      f"(packet may be lost)")
    return results


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--id", default="C1", help="Client ID")
    p.add_argument("--ip", default="127.0.0.1", help="Server IP address")
    p.add_argument("--proto", choices=["tcp", "udp"], help="Protocol")
    p.add_argument("--port", type=int, help="Port number")
    p.add_argument("--msg", nargs="*", help="Message(s) to send")
    a = p.parse_args()

    proto = a.proto or input("Protocol (tcp/udp): ").strip().lower()
    port = a.port or (TCP_PORT if proto == "tcp" else UDP_PORT)
    msgs = a.msg or [input("Message: ")]

    send = send_tcp if proto == "tcp" else send_udp
    send(a.id, a.ip, port, msgs)


if _name_ == "_main_":
    main()
